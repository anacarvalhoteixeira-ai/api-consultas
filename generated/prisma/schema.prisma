generator client {
  provider               = "prisma-client-js"
  output                 = "../generated/prisma"
  moduleFormat           = "esm"
  generatedFileExtension = "js"
  importFileExtension    = "js"
}

datasource db {
  provider = "mysql"
}

enum Role {
  ADMIN
  MEDICO
  PACIENTE
}

model Usuario {
  id       Int    @id @default(autoincrement())
  nome     String @db.VarChar(150)
  email    String @unique @db.VarChar(150)
  password String @db.VarChar(255)
  role     Role   @default(PACIENTE)

  consultasComoPaciente Consulta[] @relation("PacienteConsultas")
  consultasComoMedico   Consulta[] @relation("MedicoConsultas")
}

model Consulta {
  id            Int      @id @default(autoincrement())
  especialidade String   @db.VarChar(100)
  dataConsulta  DateTime

  pacienteId Int
  paciente   Usuario @relation("PacienteConsultas", fields: [pacienteId], references: [id])

  medicoId Int
  medico   Usuario @relation("MedicoConsultas", fields: [medicoId], references: [id])
}
